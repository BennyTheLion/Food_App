{
  "forms": [
    {
      "id": 1,
      "name": "בדיקת ריכוז חומר חיטוי",
      "description": "בדיקת ריכוז חומר חיטוי פעמיים ביום. ריכוז רצוי: 80-100 ppm. R-100-04",
      "category": "חיטוי וניקיון",
      "active": false
    },
    {
      "id": 2,
      "name": "רישום פעולת מקרר מהיר",
      "description": "תיעוד כניסה ויציאה של מוצרים ממקרר מהיר. R-100-03",
      "category": "אחסון וקירור"
    },
    {
      "id": 3,
      "name": "רישום קבלת חומרי גלם",
      "description": "רישום קבלת מוצרים מהספק - בדיקה ויזואלית, טמפרטורה, תאריך תפוגה",
      "category": "קבלת סחורה"
    },
    {
      "id": 4,
      "name": "קבלה והגשת מזון בתחנות",
      "description": "רישום מנה בודדת - בדיקת טמפרטורות קבלה, הוצאה מתנור והגשה + בדיקה אורגנולפטית. R-100-01",
      "category": "קבלה והגשה"
    },
    {
      "id": 5,
      "name": "טופס ביצוע הדרכה",
      "description": "תיעוד הדרכת בטיחות מזון - פרטי ההדרכה ורשימת משתתפים. R-100-22",
      "category": "הדרכה"
    },
    {
      "id": 6,
      "name": "בדיקת טמפרטורה יומית — מקררים ומקפיאים",
      "description": "מעקב טמפרטורה בתחילת וסיום יום עבודה לכל מקרר/מקפיא. מקרר: 0 עד 5°C, מקפיא: −25 עד −18°C.",
      "category": "אחסון וקירור"
    },
    {
      "id": 7,
      "name": "מדידת טמפרטורה בזמן הגשה",
      "description": "בדיקת טמפרטורת הגשה לכל מנה. מזון חם: הגשה ≥70°C, מזון קר/סלטים: הגשה ≤5°C.",
      "category": "הגשה ואיכות"
    },
    {
      "id": 8,
      "name": "מדידת טמפרטורה יציאה מהתנור",
      "description": "בדיקת טמפרטורת יציאה מהתנור למנות חמות בלבד. סף מינימלי: 70°C.",
      "category": "הגשה ואיכות"
    },
    {
      "id": 9,
      "name": "בדיקת עובדים לפני תחילת עבודה",
      "description": "בדיקת מראה והיגיינה אישית לכל עובד לפני כניסה למשמרת: ציפורניים, גילוח, ליבוש, כיסוי ראש ותכשיטים.",
      "category": "היגיינה ובטיחות"
    },
    {
      "id": 10,
      "name": "חיטוי ירקות ופירות",
      "description": "רישום חיטוי ירקות ופירות לפני הכנה",
      "category": "חיטוי וניקיון"
    },
    {
      "id": 11,
      "name": "טופס טמפ' גמר בישול",
      "description": "טמפ' יציאה מבישול לפחות 75°C — בדיקה במרכז המוצר. יש לחטא מד טמפ' לפני ואחרי הבדיקה. R-100-17",
      "category": "הגשה ואיכות"
    },
    {
      "id": 12,
      "name": "מעקב החלפת שמן לטיגון",
      "description": "סינון/החלפת שמן כשהשמן קר. סינון בסוף כל יום; החלפה אחרי טיגון דגים/חצילים, בהופעת קצף/עשן או TPM מעל 27%. אין להשליך שמן לביוב. R-100-06",
      "category": "הגשה ואיכות"
    },
    {
      "id": 13,
      "name": "מעקב הפשרה בשר / עוף / דגים",
      "description": "רישום הכנסה והוצאה מהפשרה — טמפרטורה בסיום הפשרה עד 5°C תקינה. מעל 5°C — חריגה.",
      "category": "הפשרה"
    }
